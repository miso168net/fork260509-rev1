# =============================================================================
# rev1 deploy .env 範本(W-F3)
#
# user 須 cp .env.example .env 並編輯填值;.env 已被 .gitignore 排除(line 57)
# =============================================================================

# === COMPOSE 命名(per CLAUDE.md §5.2、Q3 clarify)===
# 避免與 fork260509 既有 new-admin project 衝突
COMPOSE_PROJECT_NAME=rev1-admin

# === TZ(預設 Asia/Shanghai)===
TZ=Asia/Shanghai

# === POSTGRES(用於 postgres service + APP_DATABASE_URL 構造)===
POSTGRES_USER=soybean
# 警告:密碼若含 @ / : / / / # / ? 等 URL special char,DATABASE_URL parse 出錯
# 推薦用 hex 字串避免:openssl rand -hex 16
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=soybean_admin_rust

# === REDIS(用於 redis service + APP_REDIS_URL 構造)===
# 同上密碼限制(避免 URL special char)
REDIS_PASSWORD=change-me-strong-password

# === RUST-API(F1.1 strict secret validation 必要)===
# MUST replace before docker compose up(否則 rust-api 啟動 panic):
#   openssl rand -hex 32
APP_JWT_JWT_SECRET=replace-with-openssl-rand-hex-32

# === IMAGE TAGS(W-F1 / W-F2 acceptance 階段已 build local)===
# 可改 short SHA(`<sha>`)或 prod tag(`prod-<YYYYMMDD>`、W-F17 後)
IMAGE_TAG=rev1-admin-rust-api
BASE_WEB_TAG=rev1-admin-base-web
