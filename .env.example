# =============================================================================
# rev1 deploy .env 範本(W-F4)
#
# user 須 cp .env.example .env 並編輯填值;.env 已被 .gitignore 排除
# =============================================================================

# === COMPOSE 命名(per CLAUDE.md §5.2)===
# 避免與 fork260509 既有 new-admin project 衝突
COMPOSE_PROJECT_NAME=rev1-admin

# === TZ(預設 Asia/Shanghai)===
TZ=Asia/Shanghai

# === POSTGRES non-secret env(POSTGRES_USER + POSTGRES_DB 由 .env 設、POSTGRES_PASSWORD 走 secret file)===
POSTGRES_USER=soybean
POSTGRES_DB=soybean_admin_rust

# === IMAGE TAGS(W-F1 / W-F2 acceptance 階段已 build local)===
# 可改 short SHA(`<sha>`)或 prod tag(`prod-<YYYYMMDD>`、W-F17 後)
IMAGE_TAG=rev1-admin-rust-api
BASE_WEB_TAG=rev1-admin-base-web

# =============================================================================
# === SECRETS:W-F4 後改走 deploy/secrets/*.txt(per /speckit-analyze U1 拍板)===
# =============================================================================
# Prod / dev 統一走 secrets file 模式(只差 secret 值 dev-friendly vs prod-grade):
#   1. cp deploy/secrets/<name>.txt.example deploy/secrets/<name>.txt(對 5 個 secret 各一次)
#   2. 編輯 5 個 .txt 填入實際 secret 值(注意雙寫紀律:database_url 內 password 段
#      與 postgres_password.txt 純值一致;redis_url 內 password 段與 redis_password.txt 純值一致)
#   3. chmod 0600 deploy/secrets/*.txt(host filesystem 保護;W-F4 acceptance 不 enforce)
#   4. docker compose up -d
#
# 詳細說明見 deploy/secrets/README.md
#
# Advanced operator 若需 envvar mode(不走 secrets file):自製 docker-compose.override.yml
# 移除 *_FILE env + secrets: ref + secrets top-level 段;然後 uncomment 以下 5 行填值:
#
# APP_JWT_JWT_SECRET=
# APP_DATABASE_URL=
# APP_REDIS_URL=
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
