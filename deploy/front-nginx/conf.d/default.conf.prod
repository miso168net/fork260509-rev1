# Docker embedded DNS — http context(per W-F11 data-model.md E6)
# upstream `resolve` 需要 resolver;valid=10s 控制 re-resolve 週期、ipv6=off 略過 AAAA
resolver 127.0.0.11 valid=10s ipv6=off;

# 044 W-F12 (FR-002, DESIGN-W §8.1): JSON access_log → loki ingestion
log_format json_combined escape=json '{'
  '"timestamp":"$time_iso8601",'
  '"level":"info",'
  '"service":"front-nginx",'
  '"request_id":"$request_id",'
  '"msg":"$request",'
  '"http_method":"$request_method",'
  '"route":"$uri",'
  '"http_status":$status,'
  '"latency_ms":"$request_time",'
  '"remote_addr":"$remote_addr",'
  '"upstream":"$upstream_addr",'
  '"upstream_response_time":"$upstream_response_time",'
  '"bytes_sent":$bytes_sent,'
  '"http_user_agent":"$http_user_agent"'
'}';

upstream base_web {
    server base-web:8080;
}

upstream rust_api {
    zone rust_api 64k;                  # shared memory zone — `resolve` 必要前提
    server rust-api:11081 resolve;      # 動態解析 rust-api replica(nginx 1.27 支援)
    keepalive 32;
}

# 80 listen(prod 強制 redirect、保 Let's Encrypt HTTP-01 challenge 路徑)
server {
    listen 80;
    server_name _;

    access_log /var/log/nginx/access.log json_combined;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 443 listen ssl(prod 同 dev、cert 從 named volume)
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    access_log /var/log/nginx/access.log json_combined;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    location = /health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /api/ {
        proxy_pass http://rust_api/;
        include /etc/nginx/snippets/proxy_headers.inc;
    }

    location / {
        proxy_pass http://base_web;
        proxy_set_header Host $host;
    }
}
